# Copy this file to .env and fill in your key to switch from sample mode to live mode.
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: port (default 8000)
# PORT=8000

# Optional: force sample mode even with a key set
# MOCK=1
